{
  "name": "CANChat Local Archive",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "postCreateCommand": "npm ci",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "javascript.preferences.importModuleSpecifier": "relative"
      }
    }
  }
}
